{{ comment }} Generated by NetManage: {{ src_label }} -> {{ dst_label }}
sysname {{ hostname or "Router" }}
#
{% if dns %}
dns resolve
{% endif %}
{% for s in dns %}
dns server {{ s }}
{% endfor %}
{% if domain %}
dns domain {{ domain }}
{% endif %}
{% if vlans %}
vlan batch {{ vlans | map(attribute="id") | join(" ") }}
#
{% endif %}
{% for v in vlans if v.name %}
vlan {{ v.id }}
 name {{ v.name }}
#
{% endfor %}
{% for v in vrfs %}
ip vpn-instance {{ v }}
 ipv4-family
#
{% endfor %}
{% include "policy_huawei_vrp.j2" %}
{% for i in interfaces %}
interface {{ i.name }}
{% if i.description %}
 description {{ i.description }}
{% endif %}
{% if i.kind in ("physical", "lag") and i.addrs and not i.unit and not i.mode %}
 undo portswitch
{% endif %}
{% if i.dot1q and i.unit %}
 dot1q termination vid {{ i.dot1q }}
 arp broadcast enable
{% endif %}
{% if i.mtu %}
 mtu {{ i.mtu }}
{% endif %}
{% if i.vrf %}
 ip binding vpn-instance {{ i.vrf }}
{% endif %}
{% if i.mode == "access" %}
 port link-type access
{% if i.access_vlan %}
 port default vlan {{ i.access_vlan }}
{% endif %}
{% elif i.mode == "trunk" %}
 port link-type trunk
 port trunk allow-pass vlan {{ (i.trunk_vlans | vrp_vlans) or "all" }}
{% endif %}
{% for a in i.addrs %}
 ip address {{ a.ip }} {{ a.mask }}{{ " sub" if a.secondary }}
{% endfor %}
{% if i.ospf_cost %}
 ospf cost {{ i.ospf_cost }}
{% endif %}
{% if i.acl_in %}
 traffic-filter inbound acl {{ i.acl_in if i.acl_in.isdigit() else "name " ~ i.acl_in }}
{% endif %}
{% if i.acl_out %}
 traffic-filter outbound acl {{ i.acl_out if i.acl_out.isdigit() else "name " ~ i.acl_out }}
{% endif %}
{% if i.qos_in %}
 traffic-policy {{ i.qos_in }} inbound
{% endif %}
{% if i.qos_out %}
 traffic-policy {{ i.qos_out }} outbound
{% endif %}
{% if i.kind not in ("loopback", "vlan") or i.shutdown %}
 {{ "shutdown" if i.shutdown else "undo shutdown" }}
{% endif %}
#
{% endfor %}
{% if ospf %}
ospf {{ ospf.process }}{{ " router-id " ~ ospf.router_id if ospf.router_id }}
{% for p in ospf.passive %}
 silent-interface {{ p }}
{% endfor %}
{% for r in ospf.redistribute %}
 import-route {{ "direct" if r == "connected" else r }}{{ " route-policy " ~ ospf.redistribute_map[r] if r in ospf.redistribute_map }}
{% endfor %}
{% if ospf.default_originate %}
 default-route-advertise
{% endif %}
{% for a in ospf.areas %}
 area {{ a.dotted }}
{% for n in a.networks %}
  network {{ n.net }} {{ n.wildcard }}
{% endfor %}
{% endfor %}
#
{% endif %}
{% if bgp %}
bgp {{ bgp.asn }}
{% if bgp.router_id %}
 router-id {{ bgp.router_id }}
{% endif %}
{% for n in bgp.neighbors %}
 peer {{ n.ip }} as-number {{ n.remote_as }}
{% if n.description %}
 peer {{ n.ip }} description {{ n.description }}
{% endif %}
{% if n.update_source %}
 peer {{ n.ip }} connect-interface {{ n.update_source }}
{% endif %}
{% if n.multihop %}
 peer {{ n.ip }} ebgp-max-hop {{ n.multihop }}
{% endif %}
{% if n.shutdown %}
 peer {{ n.ip }} ignore
{% endif %}
{% endfor %}
 #
 ipv4-family unicast
{% for n in bgp.networks %}
  network {{ n.net }} {{ n.mask }}
{% endfor %}
{% for r in bgp.redistribute %}
  import-route {{ "direct" if r == "connected" else r }}{{ " route-policy " ~ bgp.redistribute_map[r] if r in bgp.redistribute_map }}
{% endfor %}
{% for n in bgp.neighbors %}
  peer {{ n.ip }} enable
{% if n.route_map_in %}
  peer {{ n.ip }} route-policy {{ n.route_map_in }} import
{% endif %}
{% if n.route_map_out %}
  peer {{ n.ip }} route-policy {{ n.route_map_out }} export
{% endif %}
{% if n.next_hop_self %}
  peer {{ n.ip }} next-hop-local
{% endif %}
{% endfor %}
#
{% endif %}
{% for r in routes %}
ip route-static{{ " vpn-instance " ~ r.vrf if r.vrf }} {{ r.net }} {{ r.mask }}{{ " NULL0" if r.null }}{{ " " ~ r.interface if r.interface }}{{ " " ~ r.nexthop if r.nexthop }}{{ " preference " ~ r.distance if r.distance }}{{ " description " ~ r.description if r.description }}
{% endfor %}
#
{% for s in ntp %}
ntp-service unicast-server {{ s }}
{% endfor %}
{% for s in syslog %}
info-center loghost {{ s }}
{% endfor %}
{% for c in snmp %}
snmp-agent community {{ "write" if c.access == "rw" else "read" }} {{ c.name }}
{% endfor %}
{% if snmp_location %}
snmp-agent sys-info location {{ snmp_location }}
{% endif %}
{% if snmp_contact %}
snmp-agent sys-info contact {{ snmp_contact }}
{% endif %}
#
return
