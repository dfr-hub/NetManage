{{ comment }} Generated by NetManage: {{ src_label }} -> {{ dst_label }}
{{ comment }} RouterOS v7 syntax.
/system identity
set name={{ (hostname or "MikroTik") | q }}
{% if needs_bridge or interfaces | selectattr("kind", "equalto", "loopback") | list %}
/interface bridge
{% if needs_bridge %}
add name=bridge1 vlan-filtering=yes
{% endif %}
{% for i in interfaces if i.kind == "loopback" %}
add name={{ i.name }}{{ " comment=" ~ (i.description | q) if i.description }}
{% endfor %}
{% endif %}
{% for i in interfaces if i.kind == "bridge" and not i.unit %}
{{ warn("Bridge " ~ i.name ~ ": pastikan sudah ada, anggota port diisi manual.") }}
{% endfor %}
{% if interfaces | selectattr("kind", "equalto", "physical") | rejectattr("unit") | list %}
/interface ethernet
{% for i in interfaces if i.kind == "physical" and not i.unit %}
set [ find default-name={{ i.name }} ] disabled={{ "yes" if i.shutdown else "no" }}{{ " mtu=" ~ i.mtu if i.mtu }}{{ " comment=" ~ (i.description | q) if i.description }}
{% endfor %}
{% endif %}
{% if interfaces | selectattr("kind", "equalto", "lag") | rejectattr("unit") | list %}
/interface bonding
{% for i in interfaces if i.kind == "lag" and not i.unit %}
add name={{ i.name }} mode=802.3ad{{ " comment=" ~ (i.description | q) if i.description }}
{{ warn("Bonding " ~ i.name ~ ": parameter slaves= harus diisi manual.") }}
{% endfor %}
{% endif %}
{% if interfaces | selectattr("unit") | list or interfaces | selectattr("kind", "equalto", "vlan") | list %}
/interface vlan
{% for i in interfaces if i.unit and i.kind != "vlan" %}
add name={{ i.name }} interface={{ i.parent }} vlan-id={{ i.dot1q or i.unit }}{{ " disabled=yes" if i.shutdown }}{{ " comment=" ~ (i.description | q) if i.description }}
{% endfor %}
{% for i in interfaces if i.kind == "vlan" %}
add name={{ i.name }} interface=bridge1 vlan-id={{ i.number }}{{ " disabled=yes" if i.shutdown }}{{ " comment=" ~ (i.description | q) if i.description }}
{% endfor %}
{% endif %}
{% if interfaces | selectattr("mode") | list %}
/interface bridge port
{% for i in interfaces if i.mode == "access" %}
add bridge=bridge1 interface={{ i.name }} pvid={{ i.access_vlan or 1 }}
{% endfor %}
{% for i in interfaces if i.mode == "trunk" %}
add bridge=bridge1 interface={{ i.name }} frame-types=admit-only-vlan-tagged
{% endfor %}
{% endif %}
{% if needs_bridge and vlans %}
/interface bridge vlan
{% for v in vlans %}
add bridge=bridge1 vlan-ids={{ v.id }} tagged={{ (["bridge1"] + v.tagged) | join(",") }}{{ " untagged=" ~ (v.untagged | join(",")) if v.untagged }}
{% endfor %}
{% endif %}
{% if vrfs %}
{{ warn("VRF (" ~ (vrfs | join(", ")) ~ ") tidak dikonversi ke RouterOS. Buat /ip vrf manual.") }}
{% endif %}
/ip address
{% for i in interfaces %}
{% for a in i.addrs %}
add address={{ a.cidr }} interface={{ i.name }}{{ " comment=" ~ (i.description | q) if i.description and i.kind not in ("physical", "loopback") }}
{% endfor %}
{% endfor %}
{% if routes %}
/ip route
{% for r in routes %}
add dst-address={{ r.prefix }}{{ " blackhole" if r.null else " gateway=" ~ (r.nexthop or r.interface) }}{{ " distance=" ~ r.distance if r.distance }}{{ " comment=" ~ (r.description | q) if r.description }}
{% endfor %}
{% endif %}
{% if dns %}
/ip dns
set servers={{ dns | join(",") }}
{% endif %}
{% if ntp %}
/system ntp client
set enabled=yes
/system ntp client servers
{% for s in ntp %}
add address={{ s }}
{% endfor %}
{% endif %}
{% if syslog %}
/system logging action
{% for s in syslog %}
add name=remote{{ loop.index }} target=remote remote={{ s }}
{% endfor %}
/system logging
{% for s in syslog %}
add action=remote{{ loop.index }} topics=info
{% endfor %}
{% endif %}
{% if snmp or snmp_location or snmp_contact %}
/snmp community
{% for c in snmp %}
add name={{ c.name | q }}{{ " write-access=yes" if c.access == "rw" }}
{% endfor %}
/snmp
set enabled=yes{{ " trap-community=" ~ (snmp[0].name | q) if snmp }}{{ " location=" ~ (snmp_location | q) if snmp_location }}{{ " contact=" ~ (snmp_contact | q) if snmp_contact }}
{% endif %}
{% if ospf %}
/routing ospf instance
add name=ospf-1 version=2{{ " router-id=" ~ ospf.router_id if ospf.router_id }}{{ " redistribute=" ~ (ospf.redistribute | join(",")) if ospf.redistribute }}{{ " originate-default=always" if ospf.default_originate }}{{ " out-filter-chain=" ~ (ospf.redistribute_map.values() | first) if ospf.redistribute_map }}
/routing ospf area
{% for a in ospf.areas %}
add name=area-{{ a.short }} area-id={{ a.dotted }} instance=ospf-1
{% endfor %}
/routing ospf interface-template
{% for a in ospf.areas %}
{% for i in a.interfaces %}
add area=area-{{ a.short }} interfaces={{ i.name }}{{ " passive" if i.passive }}{{ " cost=" ~ i.ospf_cost if i.ospf_cost }}
{% endfor %}
{% for n in a.unmatched %}
add area=area-{{ a.short }} networks={{ n.prefix }}
{% endfor %}
{% endfor %}
{% endif %}
{% if bgp %}
{% if bgp.networks %}
/ip firewall address-list
{% for n in bgp.networks %}
add list=bgp-networks address={{ n.prefix }}
{% endfor %}
{% endif %}
{% if bgp.redistribute %}
{{ warn("BGP redistribute (" ~ (bgp.redistribute | join(", ")) ~ "): set output.redistribute pada /routing bgp connection sudah ditambahkan, periksa filter.") }}
{% endif %}
/routing bgp connection
{% for n in bgp.neighbors %}
add name=peer-{{ loop.index }} remote.address={{ n.ip }} remote.as={{ n.remote_as }} as={{ bgp.asn }} local.role={{ "ibgp" if n.internal else "ebgp" }}{{ " router-id=" ~ bgp.router_id if bgp.router_id }}{{ " local.address=" ~ n.update_source_ip if n.update_source_ip }}{{ " multihop=yes" if n.multihop }}{{ " nexthop-choice=force-self" if n.next_hop_self }}{{ " output.network=bgp-networks" if bgp.networks }}{{ " output.redistribute=" ~ (bgp.redistribute | join(",")) if bgp.redistribute }}{{ " input.filter=" ~ n.route_map_in if n.route_map_in }}{{ " output.filter-chain=" ~ n.route_map_out if n.route_map_out }}{{ " disabled=yes" if n.shutdown }}{{ " comment=" ~ (n.description | q) if n.description }}
{% endfor %}
{% endif %}
{% if ospf and ospf.redistribute_map and (ospf.redistribute_map.values() | unique | list | length > 1) %}
{{ warn("OSPF redistribute memakai beberapa route-map berbeda; RouterOS hanya punya satu out-filter-chain per instance.") }}
{% endif %}
{% if bgp and bgp.redistribute_map %}
{{ warn("BGP redistribute dengan route-map: di RouterOS filter memakai output.filter-chain per connection. Gabungkan manual.") }}
{% endif %}
