{{ comment }} Generated by NetManage: {{ src_label }} -> {{ dst_label }}
config system global
    set hostname {{ (hostname or "FortiGate") | q }}
end
{% if interfaces | selectattr("mode") | list %}
{{ warn("Switchport access/trunk tidak dikonversi ke FortiOS (FortiGate bukan switch L2). Gunakan VLAN interface atau hardware switch.") }}
{% endif %}
{% if vrfs %}
{{ warn("VRF (" ~ (vrfs | join(", ")) ~ ") tidak dikonversi ke FortiOS. Atur 'set vrf <id>' per interface manual.") }}
{% endif %}
config system interface
{% for i in interfaces %}
{% if i.name | length > 15 %}
{{ warn("Nama interface '" ~ i.name ~ "' lebih dari 15 karakter, FortiOS akan menolak. Persingkat manual.") }}
{% endif %}
    edit {{ i.name | q }}
        set vdom "root"
{% if i.kind == "loopback" %}
        set type loopback
{% elif i.unit and i.kind in ("physical", "lag") %}
        set type vlan
        set interface {{ i.parent | q }}
        set vlanid {{ i.dot1q or i.unit }}
{% elif i.kind == "vlan" %}
        set type vlan
        set vlanid {{ i.number }}
{{ warn("Interface " ~ i.name ~ " (SVI): isi 'set interface <port induk>' manual.") }}
{% elif i.kind == "lag" %}
        set type aggregate
{{ warn("Aggregate " ~ i.name ~ ": isi 'set member' manual.") }}
{% endif %}
{% if i.addrs %}
        set mode static
        set ip {{ i.addrs[0].ip }} {{ i.addrs[0].mask }}
        set allowaccess ping
{% endif %}
{% if i.description %}
        set description {{ i.description | q }}
{% endif %}
{% if i.mtu %}
        set mtu-override enable
        set mtu {{ i.mtu }}
{% endif %}
        set status {{ "down" if i.shutdown else "up" }}
{% if i.addrs | length > 1 %}
        set secondary-IP enable
        config secondaryip
{% for a in i.addrs[1:] %}
            edit {{ loop.index }}
                set ip {{ a.ip }} {{ a.mask }}
            next
{% endfor %}
        end
{% endif %}
    next
{% endfor %}
end
{% with part = "route" %}{% include "policy_fortinet_fortios.j2" %}{% endwith %}
{% if routes %}
config router static
{% for r in routes %}
    edit {{ loop.index }}
        set dst {{ r.net }} {{ r.mask }}
{% if r.null %}
        set blackhole enable
{% else %}
{% if r.nexthop %}
        set gateway {{ r.nexthop }}
{% endif %}
{% if r.out_if %}
        set device {{ r.out_if | q }}
{% else %}
{{ warn("Static route " ~ r.prefix ~ ": 'set device' tidak bisa ditentukan otomatis, isi manual.") }}
{% endif %}
{% endif %}
{% if r.distance %}
        set distance {{ r.distance }}
{% endif %}
{% if r.description %}
        set comment {{ r.description | q }}
{% endif %}
    next
{% endfor %}
end
{% endif %}
{% if ospf %}
config router ospf
{% if ospf.router_id %}
    set router-id {{ ospf.router_id }}
{% endif %}
{% if ospf.default_originate %}
    set default-information-originate enable
{% endif %}
{% if ospf.passive %}
    set passive-interface {{ ospf.passive | map("q") | join(" ") }}
{% endif %}
    config area
{% for a in ospf.areas %}
        edit {{ a.dotted }}
        next
{% endfor %}
    end
    config network
{% for n in ospf.networks %}
        edit {{ loop.index }}
            set prefix {{ n.net }} {{ n.mask }}
            set area {{ n.area_dotted }}
        next
{% endfor %}
    end
{% if interfaces | selectattr("ospf_cost") | list %}
    config ospf-interface
{% for i in interfaces if i.ospf_cost %}
        edit {{ i.name | q }}
            set interface {{ i.name | q }}
            set cost {{ i.ospf_cost }}
        next
{% endfor %}
    end
{% endif %}
{% for r in ospf.redistribute %}
    config redistribute {{ r | q }}
        set status enable
{% if r in ospf.redistribute_map %}
        set route-map {{ ospf.redistribute_map[r] | q }}
{% endif %}
    end
{% endfor %}
end
{% endif %}
{% if bgp %}
config router bgp
    set as {{ bgp.asn }}
{% if bgp.router_id %}
    set router-id {{ bgp.router_id }}
{% endif %}
    config neighbor
{% for n in bgp.neighbors %}
        edit {{ n.ip | q }}
            set remote-as {{ n.remote_as }}
{% if n.description %}
            set description {{ n.description | q }}
{% endif %}
{% if n.update_source %}
            set update-source {{ n.update_source | q }}
{% endif %}
{% if n.multihop %}
            set ebgp-enforce-multihop enable
            set ebgp-multihop-ttl {{ n.multihop }}
{% endif %}
{% if n.next_hop_self %}
            set next-hop-self enable
{% endif %}
{% if n.shutdown %}
            set shutdown enable
{% endif %}
{% if n.route_map_in %}
            set route-map-in {{ n.route_map_in | q }}
{% endif %}
{% if n.route_map_out %}
            set route-map-out {{ n.route_map_out | q }}
{% endif %}
        next
{% endfor %}
    end
{% if bgp.networks %}
    config network
{% for n in bgp.networks %}
        edit {{ loop.index }}
            set prefix {{ n.net }} {{ n.mask }}
        next
{% endfor %}
    end
{% endif %}
{% for r in bgp.redistribute %}
    config redistribute {{ r | q }}
        set status enable
{% if r in bgp.redistribute_map %}
        set route-map {{ bgp.redistribute_map[r] | q }}
{% endif %}
    end
{% endfor %}
end
{% endif %}
{% if dns %}
config system dns
    set primary {{ dns[0] }}
{% if dns | length > 1 %}
    set secondary {{ dns[1] }}
{% endif %}
{% if domain %}
    set domain {{ domain | q }}
{% endif %}
end
{% endif %}
{% if ntp %}
config system ntp
    set ntpsync enable
    set type custom
    config ntpserver
{% for s in ntp %}
        edit {{ loop.index }}
            set server {{ s | q }}
        next
{% endfor %}
    end
end
{% endif %}
{% if syslog %}
config log syslogd setting
    set status enable
    set server {{ syslog[0] | q }}
end
{% endif %}
{% if snmp or snmp_location or snmp_contact %}
config system snmp sysinfo
    set status enable
{% if snmp_location %}
    set location {{ snmp_location | q }}
{% endif %}
{% if snmp_contact %}
    set contact-info {{ snmp_contact | q }}
{% endif %}
end
{% endif %}
{% if snmp %}
config system snmp community
{% for c in snmp %}
    edit {{ loop.index }}
        set name {{ c.name | q }}
    next
{% endfor %}
end
{% endif %}
{% with part = "firewall" %}{% include "policy_fortinet_fortios.j2" %}{% endwith %}
