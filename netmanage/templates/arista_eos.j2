{{ comment }} Generated by NetManage: {{ src_label }} -> {{ dst_label }}
hostname {{ hostname or "Router" }}
!
{% if domain %}
dns domain {{ domain }}
{% endif %}
{% for s in dns %}
ip name-server vrf default {{ s }}
{% endfor %}
{% for v in vrfs %}
vrf instance {{ v }}
!
{% endfor %}
ip routing
{% for v in vrfs %}
ip routing vrf {{ v }}
{% endfor %}
!
{% for v in vlans %}
vlan {{ v.id }}
{% if v.name %}
   name {{ v.name }}
{% endif %}
{% endfor %}
!
{% include "policy_arista_eos.j2" %}
{% for i in interfaces %}
interface {{ i.name }}
{% if i.description %}
   description {{ i.description }}
{% endif %}
{% if i.dot1q and i.unit %}
   encapsulation dot1q vlan {{ i.dot1q }}
{% endif %}
{% if i.mode == "access" %}
   switchport mode access
{% if i.access_vlan %}
   switchport access vlan {{ i.access_vlan }}
{% endif %}
{% elif i.mode == "trunk" %}
   switchport mode trunk
{% if i.trunk_vlans %}
   switchport trunk allowed vlan {{ i.trunk_vlans }}
{% endif %}
{% elif i.kind in ("physical", "lag") and i.addrs and not i.unit %}
   no switchport
{% endif %}
{% if i.vrf %}
   vrf {{ i.vrf }}
{% endif %}
{% for a in i.addrs %}
   ip address {{ a.cidr }}{{ " secondary" if a.secondary }}
{% endfor %}
{% if i.mtu %}
   mtu {{ i.mtu }}
{% endif %}
{% if i.ospf_cost %}
   ip ospf cost {{ i.ospf_cost }}
{% endif %}
{% if i.acl_in %}
   ip access-group {{ i.acl_in }} in
{% endif %}
{% if i.acl_out %}
   ip access-group {{ i.acl_out }} out
{% endif %}
{% if i.qos_in %}
   service-policy type qos input {{ i.qos_in }}
{% endif %}
{% if i.qos_out %}
{{ warn("Interface " ~ i.name ~ ": EOS hanya mendukung service-policy qos input, policy output " ~ i.qos_out ~ " tidak dipasang.") }}
{% endif %}
   {{ "shutdown" if i.shutdown else "no shutdown" }}
!
{% endfor %}
{% if ospf %}
router ospf {{ ospf.process }}
{% if ospf.router_id %}
   router-id {{ ospf.router_id }}
{% endif %}
{% for n in ospf.networks %}
   network {{ n.prefix }} area {{ n.area_dotted }}
{% endfor %}
{% for p in ospf.passive %}
   passive-interface {{ p }}
{% endfor %}
{% for r in ospf.redistribute %}
   redistribute {{ r }}{{ " route-map " ~ ospf.redistribute_map[r] if r in ospf.redistribute_map }}
{% endfor %}
{% if ospf.default_originate %}
   default-information originate
{% endif %}
!
{% endif %}
{% if bgp %}
router bgp {{ bgp.asn }}
{% if bgp.router_id %}
   router-id {{ bgp.router_id }}
{% endif %}
{% for n in bgp.neighbors %}
   neighbor {{ n.ip }} remote-as {{ n.remote_as }}
{% if n.description %}
   neighbor {{ n.ip }} description {{ n.description }}
{% endif %}
{% if n.update_source %}
   neighbor {{ n.ip }} update-source {{ n.update_source }}
{% endif %}
{% if n.multihop %}
   neighbor {{ n.ip }} ebgp-multihop {{ n.multihop }}
{% endif %}
{% if n.next_hop_self %}
   neighbor {{ n.ip }} next-hop-self
{% endif %}
{% if n.shutdown %}
   neighbor {{ n.ip }} shutdown
{% endif %}
{% if n.route_map_in %}
   neighbor {{ n.ip }} route-map {{ n.route_map_in }} in
{% endif %}
{% if n.route_map_out %}
   neighbor {{ n.ip }} route-map {{ n.route_map_out }} out
{% endif %}
{% endfor %}
{% for n in bgp.networks %}
   network {{ n.prefix }}
{% endfor %}
{% for r in bgp.redistribute %}
   redistribute {{ r }}{{ " route-map " ~ bgp.redistribute_map[r] if r in bgp.redistribute_map }}
{% endfor %}
!
{% endif %}
{% for r in routes %}
ip route{{ " vrf " ~ r.vrf if r.vrf }} {{ r.prefix }}{{ " Null0" if r.null }}{{ " " ~ r.interface if r.interface }}{{ " " ~ r.nexthop if r.nexthop }}{{ " " ~ r.distance if r.distance }}{{ " name " ~ (r.description | replace(" ", "_")) if r.description }}
{% endfor %}
!
{% for s in ntp %}
ntp server {{ s }}
{% endfor %}
{% for s in syslog %}
logging host {{ s }}
{% endfor %}
{% for c in snmp %}
snmp-server community {{ c.name }} {{ c.access }}
{% endfor %}
{% if snmp_location %}
snmp-server location {{ snmp_location }}
{% endif %}
{% if snmp_contact %}
snmp-server contact {{ snmp_contact }}
{% endif %}
!
end
